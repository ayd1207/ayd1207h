<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Rhythm Reciprocity Piano</title>
    <!-- Tailwind CSS for UI layout -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #06050e;
            color: #ffffff;
            overflow: hidden;
            touch-action: manipulation;
            user-select: none;
        }

        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        /* Lane Background Gradients */
        .lane-bg {
            background: linear-gradient(180deg, rgba(12, 10, 26, 0.4) 0%, rgba(20, 16, 46, 0.8) 85%, rgba(36, 26, 82, 0.95) 100%);
        }

        /* Dynamic Visual Reciprocity Glow Levels */
        .reciprocity-tier-0 { filter: drop-shadow(0 0 4px rgba(139, 92, 246, 0.2)); }
        .reciprocity-tier-1 { filter: drop-shadow(0 0 12px rgba(59, 130, 246, 0.5)); }
        .reciprocity-tier-2 { filter: drop-shadow(0 0 24px rgba(236, 72, 153, 0.75)); }
        .reciprocity-tier-3 { filter: drop-shadow(0 0 38px rgba(245, 158, 11, 0.95)); }

        /* Key hit line pulse */
        .hit-line {
            box-shadow: 0 0 15px #00f3ff, 0 0 30px #00f3ff;
        }

        /* Büyütülmüş Nota Blokları */
        .note-tile {
            position: absolute;
            width: 90%;
            left: 5%;
            height: 42px;
            border-radius: 10px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.75);
            transition: border-color 0.2s ease;
        }

        .note-lane-0 { background: linear-gradient(135deg, #ff0077, #ff5599); border: 3px solid #ffb3d9; }
        .note-lane-1 { background: linear-gradient(135deg, #00d2ff, #0077ff); border: 3px solid #a6edff; }
        .note-lane-2 { background: linear-gradient(135deg, #00ff88, #00b359); border: 3px solid #b3ffd9; }
        .note-lane-3 { background: linear-gradient(135deg, #ffaa00, #ff6600); border: 3px solid #ffe6b3; }

        /* Key press visual responses */
        .key-active-0 { background: rgba(255, 0, 119, 0.45) !important; border-color: #ff0077 !important; box-shadow: 0 0 25px #ff0077; transform: translateY(2px); }
        .key-active-1 { background: rgba(0, 210, 255, 0.45) !important; border-color: #00d2ff !important; box-shadow: 0 0 25px #00d2ff; transform: translateY(2px); }
        .key-active-2 { background: rgba(0, 255, 136, 0.45) !important; border-color: #00ff88 !important; box-shadow: 0 0 25px #00ff88; transform: translateY(2px); }
        .key-active-3 { background: rgba(255, 170, 0, 0.45) !important; border-color: #ffaa00 !important; box-shadow: 0 0 25px #ffaa00; transform: translateY(2px); }

        /* Floating Score Text Keyframe */
        @keyframes popAndFade {
            0% { transform: translate(-50%, 0) scale(0.6); opacity: 0; }
            30% { transform: translate(-50%, -18px) scale(1.25); opacity: 1; }
            100% { transform: translate(-50%, -50px) scale(0.95); opacity: 0; }
        }

        .feedback-popup {
            animation: popAndFade 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.27) FORWARDS;
        }

        /* Gül Animasyonu */
        @keyframes bloom {
            0% { transform: scale(0.2) rotate(-20deg); opacity: 0; filter: drop-shadow(0 0 0px red); }
            60% { transform: scale(1.15) rotate(10deg); opacity: 1; filter: drop-shadow(0 0 35px #ff2a6d); }
            100% { transform: scale(1) rotate(0deg); opacity: 1; filter: drop-shadow(0 0 25px #ff0055); }
        }

        .rose-bloom {
            animation: bloom 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        /* Scanline Overlay */
        .scanline {
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0),
                rgba(255,255,255,0) 50%,
                rgba(0, 0, 0, 0.35) 50%,
                rgba(0, 0, 0, 0.35)
            );
            background-size: 100% 4px;
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col justify-between items-center relative overflow-hidden bg-slate-950">


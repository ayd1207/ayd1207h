    <!-- Main JavaScript Logic -->
    <script>
        /**
         * WEB AUDIO API SYNTHESIZER
         */
        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.laneFrequencies = [261.63, 329.63, 392.00, 493.88];
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playHit(laneIndex, tier = 0) {
                if (!this.ctx) return;
                
                const now = this.ctx.currentTime;
                const baseFreq = this.laneFrequencies[laneIndex];

                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = tier >= 2 ? 'triangle' : 'sine';
                osc.frequency.setValueAtTime(baseFreq, now);

                if (tier >= 1) {
                    const subOsc = this.ctx.createOscillator();
                    const subGain = this.ctx.createGain();
                    subOsc.type = 'sine';
                    subOsc.frequency.setValueAtTime(baseFreq * 1.5, now);
                    subGain.gain.setValueAtTime(0.08, now);
                    subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                    subOsc.connect(subGain);
                    subGain.connect(this.ctx.destination);
                    subOsc.start(now);
                    subOsc.stop(now + 0.23);
                }

                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.29);
            }

            playMiss() {
                if (!this.ctx) return;
                
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(115, now);
                osc.frequency.exponentialRampToValueAtTime(70, now + 0.18);

                gain.gain.setValueAtTime(0.18, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.19);
            }

            playLevelUp() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const freqs = [523.25, 659.25, 783.99, 1046.50];
                freqs.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.08);
                    gain.gain.setValueAtTime(0.2, now + idx * 0.08);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.2);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now + idx * 0.08);
                    osc.stop(now + idx * 0.08 + 0.21);
                });
            }
        }

        /**
         * CANVAS PARTICLE SYSTEM
         */
        class ParticleEngine {
            constructor(canvas) {
                this.canvas = canvas;
                this.ctx = canvas.getContext('2d');
                this.particles = [];
                this.resize();
                window.addEventListener('resize', () => this.resize());
            }

            resize() {
                const rect = this.canvas.parentElement.getBoundingClientRect();
                this.canvas.width = rect.width;
                this.canvas.height = rect.height;
            }

            spawnBurst(x, y, color) {
                const count = 18;
                for (let i = 0; i < count; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const speed = Math.random() * 5.5 + 2;
                    this.particles.push({
                        x, y,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed - 1.2,
                        size: Math.random() * 4 + 2,
                        color,
                        alpha: 1,
                        decay: Math.random() * 0.035 + 0.02
                    });
                }
            }

            updateAndRender() {
                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

                for (let i = this.particles.length - 1; i >= 0; i--) {
                    const p = this.particles[i];
                    p.x += p.vx;
                    p.y += p.vy;
                    p.alpha -= p.decay;

                    if (p.alpha <= 0) {
                        this.particles.splice(i, 1);
                        continue;
                    }

                    this.ctx.save();
                    this.ctx.globalAlpha = p.alpha;
                    this.ctx.fillStyle = p.color;
                    this.ctx.shadowColor = p.color;
                    this.ctx.shadowBlur = 8;
                    this.ctx.beginPath();
                    this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    this.ctx.fill();
                    this.ctx.restore();
                }
            }
        }

        /**
         * MAIN RHYTHM CONTROLLER (3 ISKALAMA HAKKI & 5 AŞAMA)
         */
        class RhythmGame {
            constructor() {
                this.track = document.getElementById('track');
                this.lanes = [
                    document.getElementById('lane-0'),
                    document.getElementById('lane-1'),
                    document.getElementById('lane-2'),
                    document.getElementById('lane-3')
                ];
                this.scoreDisplay = document.getElementById('scoreDisplay');
                this.comboDisplay = document.getElementById('comboDisplay');
                this.accuracyDisplay = document.getElementById('accuracyDisplay');
                this.flowBar = document.getElementById('flowBar');
                this.flowTierText = document.getElementById('flowTierText');
                this.shieldBadge = document.getElementById('shieldBadge');
                this.bgGlow = document.getElementById('bgGlow');
                this.feedbackContainer = document.getElementById('feedbackContainer');
                this.levelBadge = document.getElementById('levelBadge');
                this.stageHitsCount = document.getElementById('stageHitsCount');
                this.heartsContainer = document.getElementById('heartsContainer');

                this.startOverlay = document.getElementById('startOverlay');
                this.gameOverOverlay = document.getElementById('gameOverOverlay');
                this.victoryOverlay = document.getElementById('victoryOverlay');

                this.audio = new SoundEngine();
                this.particles = new ParticleEngine(document.getElementById('fxCanvas'));

                // D - F - J - K tuş haritası
                this.keyMap = {
                    'KeyD': 0, 'd': 0, 'D': 0,
                    'KeyF': 1, 'f': 1, 'F': 1,
                    'KeyJ': 2, 'j': 2, 'J': 2,
                    'KeyK': 3, 'k': 3, 'K': 3
                };

                this.laneColors = ['#ff0077', '#00d2ff', '#00ff88', '#ffaa00'];

                // 5 Aşamalı Hız ve Aralık Ayarları (Her aşama 5 vuruş)
                this.stages = [
                    { stage: 1, speed: 0.22, interval: 1150, requiredHits: 5 },
                    { stage: 2, speed: 0.29, interval: 950,  requiredHits: 5 },
                    { stage: 3, speed: 0.38, interval: 780,  requiredHits: 5 },
                    { stage: 4, speed: 0.48, interval: 620,  requiredHits: 5 },
                    { stage: 5, speed: 0.60, interval: 480,  requiredHits: 5 }
                ];

                this.currentStageIndex = 0;
                this.stageSuccessfulHits = 0;

                this.isRunning = false;
                this.notes = [];
                this.score = 0;
                this.combo = 0;
                this.maxCombo = 0;
                this.totalHits = 0;
                this.successfulHits = 0;
                this.counts = { perfect: 0, great: 0, good: 0, miss: 0 };

                // 3 Iskalama / Can Sistemi
                this.maxLives = 3;
                this.lives = 3;

                this.flowEnergy = 50;
                this.flowTier = 0;
                this.hasShield = false;

                this.bindEvents();
                this.gameLoop = this.gameLoop.bind(this);
            }

            bindEvents() {
                window.addEventListener('keydown', (e) => {
                    if (e.repeat) return;
                    if (this.keyMap[e.code] !== undefined || this.keyMap[e.key] !== undefined) {
                        const lane = this.keyMap[e.code] !== undefined ? this.keyMap[e.code] : this.keyMap[e.key];
                        this.handleKeyPress(lane);
                    }
                });

                window.addEventListener('keyup', (e) => {
                    if (this.keyMap[e.code] !== undefined || this.keyMap[e.key] !== undefined) {
                        const lane = this.keyMap[e.code] !== undefined ? this.keyMap[e.code] : this.keyMap[e.key];
                        this.handleKeyRelease(lane);
                    }
                });

                [0, 1, 2, 3].forEach(idx => {
                    const btn = document.getElementById(`btn-key-${idx}`);
                    const triggerPress = (e) => {
                        e.preventDefault();
                        this.audio.init();
                        this.handleKeyPress(idx);
                    };
                    const triggerRelease = (e) => {
                        e.preventDefault();
                        this.handleKeyRelease(idx);
                    };

                    btn.addEventListener('touchstart', triggerPress, { passive: false });
                    btn.addEventListener('touchend', triggerRelease, { passive: false });
                    btn.addEventListener('mousedown', triggerPress);
                    btn.addEventListener('mouseup', triggerRelease);
                });

                document.getElementById('startBtn').addEventListener('click', () => this.start());
                document.getElementById('restartBtn').addEventListener('click', () => this.start());
                document.getElementById('victoryRestartBtn').addEventListener('click', () => this.start());
            }

            start() {
                this.audio.init();
                this.startOverlay.classList.add('hidden');
                this.gameOverOverlay.classList.add('hidden');
                this.victoryOverlay.classList.add('hidden');

                this.notes.forEach(n => n.element.remove());
                this.notes = [];

                this.currentStageIndex = 0;
                this.stageSuccessfulHits = 0;

                this.score = 0;
                this.combo = 0;
                this.maxCombo = 0;
                this.totalHits = 0;
                this.successfulHits = 0;
                this.counts = { perfect: 0, great: 0, good: 0, miss: 0 };
                
                // Canları sıfırla
                this.lives = this.maxLives;

                this.flowEnergy = 50;
                this.flowTier = 0;
                this.hasShield = false;

                this.updateStageHUD();
                this.updateLivesHUD();
                this.updateHUD();
                this.isRunning = true;
                this.lastTime = performance.now();
                this.lastSpawnTime = performance.now();

                requestAnimationFrame(this.gameLoop);
            }

            updateLivesHUD() {
                let hearts = '';
                for (let i = 0; i < this.maxLives; i++) {
                    hearts += (i < this.lives) ? '❤️' : '🖤';
                }
                this.heartsContainer.textContent = hearts;
            }

            updateStageHUD() {
                const currentStageNum = this.currentStageIndex + 1;
                this.levelBadge.textContent = `SEVİYE: ${currentStageNum} / 5`;
                this.stageHitsCount.textContent = this.stageSuccessfulHits.toString();
            }

            checkStageProgression() {
                const currentStageConfig = this.stages[this.currentStageIndex];
                
                if (this.stageSuccessfulHits >= currentStageConfig.requiredHits) {
                    if (this.currentStageIndex < this.stages.length - 1) {
                        this.currentStageIndex++;
                        this.stageSuccessfulHits = 0;
                        this.audio.playLevelUp();
                        this.showPopupText(`SEVİYE ${this.currentStageIndex + 1}!`, "text-amber-300 font-extrabold text-2xl");
                    } else {
                        this.triggerVictory();
                        return;
                    }
                }
                this.updateStageHUD();
            }

            triggerVictory() {
                this.isRunning = false;
                this.audio.playLevelUp();

                this.notes.forEach(n => n.element.remove());
                this.notes = [];

                document.getElementById('victoryScore').textContent = this.score.toLocaleString();
                document.getElementById('victoryCombo').textContent = this.maxCombo.toString();
                const acc = this.totalHits > 0 ? Math.round((this.successfulHits / this.totalHits) * 100) : 100;
                document.getElementById('victoryAccuracy').textContent = `${acc}%`;

                this.victoryOverlay.classList.remove('hidden');
            }

            gameOver() {
                this.isRunning = false;

                document.getElementById('finalScore').textContent = this.score.toLocaleString();
                document.getElementById('finalCombo').textContent = this.maxCombo.toString();
                document.getElementById('finalReachedStage').textContent = `${this.currentStageIndex + 1} / 5`;

                this.gameOverOverlay.classList.remove('hidden');
            }

            handleKeyPress(laneIndex) {
                if (!this.isRunning) return;

                const btn = document.getElementById(`btn-key-${laneIndex}`);
                if (btn) btn.classList.add(`key-active-${laneIndex}`);

                const trackHeight = this.track.clientHeight;
                const hitTargetY = trackHeight - 64;
                const hitTolerance = 105;

                let hitFound = false;

                for (let i = 0; i < this.notes.length; i++) {
                    const note = this.notes[i];
                    if (note.lane === laneIndex && !note.hit) {
                        const dist = Math.abs(note.y - hitTargetY);

                        if (dist <= hitTolerance) {
                            hitFound = true;
                            note.hit = true;
                            note.element.remove();
                            this.notes.splice(i, 1);

                            let rating = "GOOD!";
                            let scoreGain = 80;
                            let flowGain = 6;
                            let ratingKey = "good";
                            let colorClass = "text-emerald-400";

                            if (dist <= 35) {
                                rating = "PERFECT!";
                                scoreGain = 250;
                                flowGain = 14;
                                ratingKey = "perfect";
                                colorClass = "text-yellow-300 shadow-yellow-500";
                            } else if (dist <= 65) {
                                rating = "GREAT!";
                                scoreGain = 150;
                                flowGain = 10;
                                ratingKey = "great";
                                colorClass = "text-cyan-300";
                            }

                            this.counts[ratingKey]++;
                            this.stageSuccessfulHits++;
                            this.registerHit(laneIndex, rating, scoreGain, flowGain, hitTargetY, colorClass);
                            this.checkStageProgression();
                            break;
                        }
                    }
                }

                if (!hitFound) {
                    this.registerMiss(laneIndex, false);
                }
            }

            handleKeyRelease(laneIndex) {
                const btn = document.getElementById(`btn-key-${laneIndex}`);
                if (btn) btn.classList.remove(`key-active-${laneIndex}`);
            }

            registerHit(laneIndex, rating, baseScore, flowGain, hitY, colorClass) {
                this.combo++;
                if (this.combo > this.maxCombo) this.maxCombo = this.combo;
                this.totalHits++;
                this.successfulHits++;

                const multipliers = [1.0, 1.5, 2.0, 3.0];
                const multiplier = multipliers[this.flowTier];
                this.score += Math.round(baseScore * multiplier);

                this.flowEnergy = Math.min(100, this.flowEnergy + flowGain);
                this.checkFlowTier();

                this.audio.playHit(laneIndex, this.flowTier);

                const laneElem = this.lanes[laneIndex];
                const laneRect = laneElem.getBoundingClientRect();
                const trackRect = this.track.getBoundingClientRect();
                const particleX = (laneRect.left - trackRect.left) + laneRect.width / 2;

                this.particles.spawnBurst(particleX, hitY, this.laneColors[laneIndex]);
                this.showPopupText(rating, colorClass);

                this.updateHUD();
            }

            registerMiss(laneIndex, isPassedMiss = true) {
                if (this.hasShield) {
                    this.hasShield = false;
                    this.shieldBadge.classList.add('hidden');
                    this.showPopupText("KALKAN ENGELLEDİ!", "text-cyan-400 font-bold");
                    return;
                }

                this.combo = 0;
                if (isPassedMiss) {
                    this.totalHits++;
                    this.counts.miss++;
                }

                // 1 Can Kaybı
                this.lives--;
                this.updateLivesHUD();

                const dropAmount = isPassedMiss ? 15 : 8;
                this.flowEnergy = Math.max(0, this.flowEnergy - dropAmount);
                this.checkFlowTier();

                this.audio.playMiss();
                this.showPopupText("ISKALAMA!", "text-pink-600 font-black");

                // 3 Can bittiyse oyunu sonlandır
                if (this.lives <= 0) {
                    this.gameOver();
                    return;
                }

                this.updateHUD();
            }

            checkFlowTier() {
                const prevTier = this.flowTier;
                
                if (this.flowEnergy >= 85) this.flowTier = 3;
                else if (this.flowEnergy >= 60) this.flowTier = 2;
                else if (this.flowEnergy >= 30) this.flowTier = 1;
                else this.flowTier = 0;

                if (this.flowTier === 3 && prevTier < 3 && !this.hasShield) {
                    this.hasShield = true;
                    this.shieldBadge.classList.remove('hidden');
                    this.showPopupText("FLOW MAX: KALKAN HAZIR!", "text-yellow-400 font-bold");
                }

                this.track.className = `relative w-full h-full lane-bg rounded-t-2xl border-x-2 border-t-2 border-indigo-500/30 overflow-hidden flex shadow-2xl reciprocity-tier-${this.flowTier}`;
                
                const glowColors = [
                    'rgba(15, 23, 42, 0.4)',
                    'rgba(37, 99, 235, 0.25)',
                    'rgba(219, 39, 119, 0.35)',
                    'rgba(245, 158, 11, 0.45)'
                ];
                this.bgGlow.style.backgroundColor = glowColors[this.flowTier];
            }

            showPopupText(text, textClass) {
                const pop = document.createElement('div');
                pop.className = `feedback-popup absolute text-xl font-black drop-shadow-md ${textClass}`;
                pop.textContent = text;
                this.feedbackContainer.appendChild(pop);

                setTimeout(() => pop.remove(), 600);
            }

            updateHUD() {
                this.scoreDisplay.textContent = this.score.toString().padStart(6, '0');
                this.comboDisplay.textContent = this.combo.toString();
                
                const acc = this.totalHits > 0 ? Math.round((this.successfulHits / this.totalHits) * 100) : 100;
                this.accuracyDisplay.textContent = `${acc}%`;

                this.flowBar.style.width = `${this.flowEnergy}%`;
                
                const tierLabels = ["1.0x", "1.5x", "2.0x", "3.0x MAX"];
                this.flowTierText.textContent = `${tierLabels[this.flowTier]} PUAN`;
            }

            spawnNote() {
                const lane = Math.floor(Math.random() * 4);
                const noteElem = document.createElement('div');
                noteElem.className = `note-tile note-lane-${lane}`;
                
                this.lanes[lane].appendChild(noteElem);

                this.notes.push({
                    lane: lane,
                    y: 0,
                    element: noteElem,
                    hit: false
                });
            }

            gameLoop(timestamp) {
                if (!this.isRunning) return;

                const deltaTime = timestamp - this.lastTime;
                this.lastTime = timestamp;

                const currentStageConfig = this.stages[this.currentStageIndex];

                if (timestamp - this.lastSpawnTime > currentStageConfig.interval) {
                    this.spawnNote();
                    this.lastSpawnTime = timestamp;
                }

                const trackHeight = this.track.clientHeight;
                const missBoundary = trackHeight - 10;

                for (let i = this.notes.length - 1; i >= 0; i--) {
                    const note = this.notes[i];
                    note.y += currentStageConfig.speed * deltaTime;
                    note.element.style.top = `${note.y}px`;

                    if (note.y > missBoundary && !note.hit) {
                        note.element.remove();
                        this.notes.splice(i, 1);
                        this.registerMiss(note.lane, true);
                    }
                }

                this.particles.updateAndRender();

                requestAnimationFrame(this.gameLoop);
            }
        }

        window.addEventListener('load', () => {
            new RhythmGame();
        });
    </script>
